APP_ENV=prod
API_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://citationchat:citationchat@db:5432/citationchat
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRES_MINUTES=1440
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=123456
INIT_ADMIN_ON_STARTUP=false
INIT_DEFAULT_KB_ON_STARTUP=true

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-plus-2026-04-20

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536

STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=20
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=5
